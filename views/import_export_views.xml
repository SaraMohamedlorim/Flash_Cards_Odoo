<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flashcard_import" model="ir.ui.view">
        <field name="name">flashcard.import.form</field>
        <field name="model">flashcard.import.export</field>
        <field name="arch" type="xml">
            <form string="Import Flashcards">
                <sheet>
                    <group>
                        <group>
                            <field name="import_file" filename="filename" required="1"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>

                    <separator string="Instructions"/>
                    <group>
                        <field name="instructions" readonly="1" nolabel="1"/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- سجل الاستيراد -->
    <record id="view_flashcard_import_history_tree" model="ir.ui.view">
        <field name="name">flashcard.import.history.tree</field>
        <field name="model">flashcard.import.history</field>
        <field name="arch" type="xml">
            <tree>
                <field name="import_date"/>
                <field name="filename"/>
                <field name="imported_count"/>
                <field name="error_count"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- سجل التصدير -->
    <record id="view_flashcard_export_history_tree" model="ir.ui.view">
        <field name="name">flashcard.export.history.tree</field>
        <field name="model">flashcard.export.history</field>
        <field name="arch" type="xml">
            <tree>
                <field name="export_date"/>
                <field name="filename"/>
                <field name="card_count"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- إجراءات الاستيراد والتصدير -->
    <record id="action_flashcard_import" model="ir.actions.act_window">
        <field name="name">Import Flashcards</field>
        <field name="res_model">flashcard.import.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <record id="action_flashcard_import_history" model="ir.actions.act_window">
    <field name="name">Import History</field>
    <field name="res_model">flashcard.import.history</field>
    <field name="view_mode">tree,form</field>
   </record>

    <record id="action_flashcard_export" model="ir.actions.server">
        <field name="name">Export Flashcards</field>
        <field name="model_id" ref="model_flashcard_card"/>
        <field name="state">code</field>
        <field name="code">
            action = model.export_cards_csv(env.context.get('active_ids'))
        </field>
    </record>

    <!-- القوائم -->
    <menuitem id="menu_flashcards_import_export" name="Import/Export" 
              parent="menu_flashcards_root" sequence="40"/>
    <menuitem id="menu_flashcards_import" name="Import Cards" 
              parent="menu_flashcards_import_export" action="action_flashcard_import" sequence="10"/>

   <menuitem id="menu_flashcards_import_history"
          name="Import History"
          parent="menu_flashcards_import_export"
          action="action_flashcard_import_history"
          sequence="20"/>

</odoo>