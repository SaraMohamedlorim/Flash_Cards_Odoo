<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- عرض شجرة الفئات -->
    <record id="view_flashcard_category_tree" model="ir.ui.view">
        <field name="name">flashcard.category.tree</field>
        <field name="model">flashcard.category</field>
        <field name="arch" type="xml">
            <tree decoration-success="card_count > 0" decoration-warning="card_count == 0">
                <field name="name"/>
                <field name="card_count"/>
                <field name="total_reviews"/>
                <field name="avg_success_rate"/>
                <field name="color" widget="color"/>
            </tree>
        </field>
    </record>

    <!-- عرض نموذج الفئة -->
    <record id="view_flashcard_category_form" model="ir.ui.view">
        <field name="name">flashcard.category.form</field>
        <field name="model">flashcard.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="color" widget="color"/>
                        </group>
                        <group>
                            <field name="card_count" readonly="1"/>
                            <field name="total_reviews" readonly="1"/>
                            <field name="avg_success_rate" readonly="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_view_category_cards" type="object" 
                                string="View Cards" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- عرض شجرة العلامات -->
    <record id="view_flashcard_tag_tree" model="ir.ui.view">
        <field name="name">flashcard.tag.tree</field>
        <field name="model">flashcard.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="card_count"/>
                <field name="color" widget="color"/>
            </tree>
        </field>
    </record>

    <!-- عرض نموذج العلامة -->
    <record id="view_flashcard_tag_form" model="ir.ui.view">
        <field name="name">flashcard.tag.form</field>
        <field name="model">flashcard.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color"/>
                        <field name="card_count" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_view_tag_cards" type="object" 
                                string="View Cards" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- إجراءات الفئات -->
    <record id="action_flashcard_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">flashcard.category</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- إجراءات العلامات -->
    <record id="action_flashcard_tags" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">flashcard.tag</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- القوائم -->
    <menuitem id="menu_flashcards_categories" name="Categories" 
              parent="menu_flashcards_root" action="action_flashcard_categories" sequence="20"/>
    <menuitem id="menu_flashcards_tags" name="Tags" 
              parent="menu_flashcards_root" action="action_flashcard_tags" sequence="30"/>
</odoo>