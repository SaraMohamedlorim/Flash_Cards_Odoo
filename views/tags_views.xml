<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- عرض شجرة العلامات -->
    <record id="view_flashcard_tag_tree" model="ir.ui.view">
        <field name="name">flashcard.tag.tree</field>
        <field name="model">flashcard.tag</field>
        <field name="arch" type="xml">
            <tree decoration-success="card_count > 0" decoration-muted="card_count == 0">
                <field name="name" string="Tag Name"/>
                <field name="card_count" string="Number of Cards"/>
                <field name="color" widget="color"/>
            </tree>
        </field>
    </record>

    <!-- عرض نموذج العلامة -->
    <record id="view_flashcard_tag_form" model="ir.ui.view">
        <field name="name">flashcard.tag.form</field>
        <field name="model">flashcard.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Tag Name" placeholder="Enter tag name..."/>
                            <field name="color" widget="color"/>
                        </group>
                        <group>
                            <field name="card_count" string="Cards Count" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- زر عرض البطاقات المرتبطة -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tag_cards" type="object" 
                                class="oe_stat_button" icon="fa-book">
                            <field name="card_count" string="Cards" widget="statinfo"/>
                        </button>
                    </div>
                    
                    <footer>
                        <button name="action_view_tag_cards" type="object" 
                                string="View Related Cards" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- عرض بحث العلامات -->
    <record id="view_flashcard_tag_search" model="ir.ui.view">
        <field name="name">flashcard.tag.search</field>
        <field name="model">flashcard.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Tag Name"/>
                <filter string="Popular Tags" name="popular_tags" domain="[('card_count', '>', 0)]"/>
                <filter string="Unused Tags" name="unused_tags" domain="[('card_count', '=', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Color" name="group_by_color" context="{'group_by': 'color'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- إجراء العلامات -->
    <record id="action_flashcard_tags" model="ir.actions.act_window">
        <field name="name">Flashcard Tags</field>
        <field name="res_model">flashcard.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_popular_tags': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first tag!
            </p>
            <p>
                Tags help you organize and categorize your flashcards for easier searching and filtering.
            </p>
        </field>
    </record>

    <!-- إجراء عرض بطاقات العلامة -->
    <record id="action_view_tag_cards" model="ir.actions.act_window">
        <field name="name">Tag Cards</field>
        <field name="res_model">flashcard.card</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- قائمة العلامات -->
    <menuitem id="menu_flashcards_tags" name="Tags" 
              parent="menu_flashcards_root" 
              action="action_flashcard_tags" 
              sequence="30"/>
</odoo>